generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  uploads      Uploads[]
  recents      Recents[]
  currentSpace BigInt    @default(0)
  totalSpace   BigInt    @default(21474836480)
  role         Roles     @default(USER)
  binFiles     BinFiles[]
}

model Uploads {
  id         String   @id @default(uuid())
  fileKey    String
  fileType   String
  uploadDate String
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail  String
  starred    Boolean? @default(false)
  deleted    Boolean  @default(false)
  deleteDate DateTime? 
}

enum Roles {
  USER
  DEV
}

model Recents {
  id         String   @id @default(uuid())
  uploadType String
  accessedAt DateTime @default(now())
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  userEmail  String
}

